# image generation (pipeline 2). One key, one client.
OPENROUTER_API_KEY=

# ElevenLabs — TTS for pipeline 1.
ELEVENLABS_API_KEY=
ELEVENLABS_MALE_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_ID=
